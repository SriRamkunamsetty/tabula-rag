# Copy to .env for local development. All keys are optional; sensible
# defaults live in src/tabula_rag/config.py.

TABULA_RAG_ENVIRONMENT=dev
TABULA_RAG_LOG_LEVEL=INFO
TABULA_RAG_LOG_FORMAT=console

# Point at provisioned MI300X vLLM endpoints (see deploy/provision_mi300x.sh)
TABULA_RAG_LLM_BASE_URL=http://localhost:8000/v1
TABULA_RAG_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
TABULA_RAG_EMBEDDING_BASE_URL=http://localhost:8001/v1
TABULA_RAG_EMBEDDING_MODEL=BAAI/bge-m3
TABULA_RAG_RERANKER_BASE_URL=http://localhost:8002/v1
TABULA_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

TABULA_RAG_RETRIEVAL_TOP_K=8
TABULA_RAG_RERANK_TOP_K=4
TABULA_RAG_CLAIM_COVERAGE_THRESHOLD=0.55
TABULA_RAG_MAX_UNSUPPORTED_RATIO=0.20
TABULA_RAG_GPU_HOURLY_RATE_USD=1.99
TABULA_RAG_MEASURED_TOKENS_PER_S=900
